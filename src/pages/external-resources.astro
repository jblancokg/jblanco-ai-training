---
import PageShell from "../components/PageShell.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="External Resources - AI Training Guide">
	<PageShell chapterId="external-resources">
		<div class="prose space-y-8">
			<p>
				A collection of tools, references, and videos worth exploring as you develop your
				AI-assisted workflow.
			</p>

			<h3>Tools & References</h3>
			<ul class="space-y-3 list-none pl-0">
				<li>
					<a
						href="https://skills.sh"
						target="_blank"
						rel="noopener noreferrer"
						class="text-orange-600 hover:text-orange-700 font-medium"
					>
						skills.sh
					</a>
					<span class="text-stone-500"> &mdash; A directory of skills for AI coding tools.</span>
				</li>
				<li>
					<a
						href="https://agentskills.io/"
						target="_blank"
						rel="noopener noreferrer"
						class="text-orange-600 hover:text-orange-700 font-medium"
					>
						agentskills.io
					</a>
					<span class="text-stone-500"> &mdash; Browse and discover agent skills.</span>
				</li>
			</ul>

			<h3>Videos</h3>
			<ul class="space-y-3 list-none pl-0">
				<li>
					<a
						href="https://www.youtube.com/watch?v=rmvDxxNubIg"
						target="_blank"
						rel="noopener noreferrer"
						class="text-orange-600 hover:text-orange-700 font-medium"
					>
						How to use AI coding tools effectively
					</a>
					<span class="text-stone-500">
						&mdash; A practical walkthrough worth watching. Credit to Kurtis Law for finding this one.
					</span>
				</li>
			</ul>
		</div>
	</PageShell>
</MainLayout>
