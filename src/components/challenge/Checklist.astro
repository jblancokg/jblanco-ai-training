---
interface Props {
	items: string[];
	title?: string;
}

const { items, title = "In a single prompt, your agent should" } = Astro.props;
---

<div class="my-8 border border-rule rounded-lg px-5 py-4">
	<div class="font-sans text-[10.5px] uppercase tracking-[0.14em] text-stone-400 mb-3">{title}</div>
	<ul class="space-y-2">
		{
			items.map((item) => (
				<li>
					<label class="flex gap-3 items-start text-[15px] text-stone-700 leading-relaxed cursor-pointer has-checked:text-stone-400 has-checked:line-through">
						<input type="checkbox" class="mt-1.5 shrink-0 accent-ember" />
						<span>{item}</span>
					</label>
				</li>
			))
		}
	</ul>
	<slot />
</div>
