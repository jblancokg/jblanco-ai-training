---
type Attachment = { name: string; href: string };

type Props = { attachments?: Attachment[] } & (
	| { kind: "email"; from: string; to: string; date: string; subject: string }
	| { kind: "ticket"; id: string; type: string; priority: string; reporter: string; title: string }
);

const props = Astro.props;
const attachments = props.attachments ?? [];
const isImage = (href: string) => /\.(png|jpe?g|gif|webp)$/i.test(href);
---

<figure class="my-8">
	<figcaption class="font-sans text-[10.5px] uppercase tracking-[0.14em] text-stone-400 mb-2">
		{props.kind === "email" ? "The email" : "The ticket"}
	</figcaption>
	<div class="bg-white border border-stone-200 rounded-lg shadow-sm overflow-hidden font-sans">
		{
			props.kind === "email" && (
				<div class="px-5 py-4 border-b border-stone-100">
					<div class="text-[17px] font-semibold text-stone-900 mb-3">{props.subject}</div>
					<dl class="grid grid-cols-[3.5rem_1fr] gap-y-0.5 text-[13px]">
						<dt class="text-stone-400">From</dt>
						<dd class="text-stone-700">{props.from}</dd>
						<dt class="text-stone-400">To</dt>
						<dd class="text-stone-700">{props.to}</dd>
						<dt class="text-stone-400">Date</dt>
						<dd class="text-stone-700">{props.date}</dd>
					</dl>
				</div>
			)
		}
		{
			props.kind === "ticket" && (
				<div class="px-5 py-4 border-b border-stone-100">
					<div class="flex flex-wrap items-center gap-2 text-[12px] mb-2">
						<span class="font-mono text-stone-500">{props.id}</span>
						<span class="px-1.5 py-0.5 rounded bg-sky-50 text-sky-700 border border-sky-200">{props.type}</span>
						<span class="px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200">{props.priority}</span>
					</div>
					<div class="text-[17px] font-semibold text-stone-900">{props.title}</div>
					<div class="text-[13px] text-stone-500 mt-1">Reported by {props.reporter}</div>
				</div>
			)
		}
		<div class="px-5 py-4 text-[14px] text-stone-800 leading-relaxed space-y-3">
			<slot />
		</div>
		{
			attachments.length > 0 && (
				<div class="px-5 py-4 border-t border-stone-100 bg-stone-50 flex flex-wrap gap-4 items-start">
					{attachments.map((a) =>
						isImage(a.href) ? (
							<a href={a.href} target="_blank" class="group block">
								<img src={a.href} alt={a.name} class="max-h-72 w-auto rounded border border-stone-200 group-hover:border-stone-400" loading="lazy" />
								<span class="block mt-1 text-[12px] text-stone-500 group-hover:text-stone-900">{a.name}</span>
							</a>
						) : (
							<a href={a.href} download class="group flex items-center gap-2 bg-white border border-stone-200 rounded-md p-1.5 pr-3 hover:border-stone-400">
								<span class="w-10 h-10 rounded bg-stone-100 flex items-center justify-center text-[10px] font-semibold uppercase text-stone-500">
									{a.href.split(".").pop()}
								</span>
								<span class="text-[12px] text-stone-600 group-hover:text-stone-900">{a.name}</span>
							</a>
						),
					)}
				</div>
			)
		}
	</div>
</figure>
