---
interface Props {
	/** What the challenge demonstrates about working with an agent */
	skill: string;
}

const { skill } = Astro.props;
---

<div class="my-8 border-l-2 border-ember pl-5">
	<div class="font-sans text-[10.5px] uppercase tracking-[0.14em] text-stone-400 mb-1">What this shows</div>
	<p class="font-serif text-lg text-ink leading-snug mb-3">{skill}</p>
	<div class="text-base text-stone-600 leading-[1.85]">
		<slot />
	</div>
</div>
