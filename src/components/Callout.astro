---
interface Props {
	variant: "tip" | "warning" | "info" | "example" | "success";
	title?: string;
}

const { variant, title } = Astro.props;

const config = {
	tip: {
		bg: "bg-amber-50",
		border: "border-amber-200",
		label: "text-amber-600",
		text: "text-amber-800",
		defaultTitle: "Tip",
	},
	warning: {
		bg: "bg-red-50",
		border: "border-red-200",
		label: "text-red-600",
		text: "text-red-800",
		defaultTitle: "Warning",
	},
	info: {
		bg: "bg-violet-50",
		border: "border-violet-200",
		label: "text-violet-600",
		text: "text-violet-800",
		defaultTitle: "Note",
	},
	example: {
		bg: "bg-stone-50",
		border: "border-stone-200",
		label: "text-stone-500",
		text: "text-stone-700",
		defaultTitle: "Example",
	},
	success: {
		bg: "bg-emerald-50",
		border: "border-emerald-200",
		label: "text-emerald-600",
		text: "text-emerald-800",
		defaultTitle: "What works",
	},
} as const;

const c = config[variant];
const displayTitle = title ?? c.defaultTitle;
---

<div class={`${c.bg} border ${c.border} rounded-lg px-5 py-4 my-8`}>
	<div class={`text-xs font-bold ${c.label} uppercase tracking-wider mb-1`}>
		{displayTitle}
	</div>
	<div class={`text-sm ${c.text} leading-relaxed`}>
		<slot />
	</div>
</div>
