---
import { CHAPTERS, getNavigableItems, getUrlForNavItem, TRACK_META } from "../data/chapters";

interface Props {
	chapterId: string;
	subChapterId?: string;
}

const { chapterId, subChapterId } = Astro.props;

const chapter = CHAPTERS.find((c) => c.id === chapterId);
const trackMeta = chapter ? TRACK_META[chapter.track] : TRACK_META.both;

let displayLabel = chapter?.label ?? "";
let subtitle = chapter?.subtitle ?? "";
if (subChapterId && chapter?.subChapters) {
	const sub = chapter.subChapters.find((s) => s.id === subChapterId);
	if (sub) {
		displayLabel = sub.label;
		subtitle = sub.subtitle ?? "";
	}
}

const chapterIdx = CHAPTERS.findIndex((c) => c.id === chapterId);
let chapterNum = `${chapterIdx + 1}`;
if (subChapterId && chapter?.subChapters) {
	const subIdx = chapter.subChapters.findIndex((s) => s.id === subChapterId);
	chapterNum = `${chapterIdx + 1}.${subIdx + 1}`;
}

const navItems = getNavigableItems();
const currentIdx = navItems.findIndex((item) => item.chapterId === chapterId && item.subChapterId === subChapterId);
const prev = currentIdx > 0 ? navItems[currentIdx - 1] : null;
const next = currentIdx < navItems.length - 1 ? navItems[currentIdx + 1] : null;
---

<main class="flex-1 min-h-screen">
  <!-- Top bar -->
  <div class="sticky top-0 z-10 bg-paper/95 backdrop-blur-sm border-b border-rule px-4 sm:px-12 py-2.5">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-2 min-w-0 font-sans text-[10.5px] uppercase tracking-[0.12em] text-stone-400">
        <button
          class="lg:hidden mr-1 p-1 -ml-1 text-stone-500 hover:text-ink"
          onclick="document.getElementById('sidebar-overlay')?.classList.remove('hidden');document.getElementById('sidebar-panel')?.classList.remove('-translate-x-full');"
          aria-label="Open menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <span class="hidden sm:inline">AI Training Guide</span>
        <span class="hidden sm:inline text-stone-300">&middot;</span>
        <span class={trackMeta.color}>{trackMeta.label}</span>
        {subChapterId && chapter && (
          <>
            <span class="text-stone-300">&middot;</span>
            <span class="truncate text-stone-500">{chapter.label}</span>
          </>
        )}
      </div>
      <span class="shrink-0 font-sans text-[10.5px] tabular-nums text-stone-400">{currentIdx + 1} / {navItems.length}</span>
    </div>
  </div>

  <!-- Content -->
  <div class="max-w-4xl mx-auto px-4 sm:px-12 pt-10 sm:pt-14 pb-6" data-pagefind-body>
    <div class="flex items-baseline gap-3 font-sans text-[11px] uppercase tracking-[0.16em]">
      <span class="text-stone-400">Chapter {chapterNum}</span>
      <span class="w-6 h-px bg-rule self-center"></span>
      <span class={trackMeta.color}>{trackMeta.label}</span>
    </div>
    <h1 class="font-serif text-3xl sm:text-[2.6rem] font-bold text-ink tracking-tight leading-[1.12] mt-3 mb-4">
      {displayLabel}
    </h1>
    {subtitle && (
      <p class="font-serif italic text-lg text-stone-500 leading-relaxed max-w-xl">
        {subtitle}
      </p>
    )}
    <div class="double-rule my-8"></div>

    <slot />
  </div>

  <!-- End-of-page pagination -->
  <div class="max-w-4xl mx-auto px-4 sm:px-12 pb-16" data-pagefind-ignore>
    <div class="double-rule"></div>
    <div class="pt-5 grid grid-cols-2 gap-8">
      <div>
        {prev && (
          <a href={getUrlForNavItem(prev)} class="group block">
            <div class="font-sans text-[10px] uppercase tracking-[0.16em] text-stone-400 mb-1.5">Previous</div>
            <div class="font-serif text-[15px] text-stone-600 group-hover:text-ember leading-snug">
              &larr;&nbsp; {prev.label}
            </div>
          </a>
        )}
      </div>
      <div class="text-right">
        {next && (
          <a href={getUrlForNavItem(next)} class="group block">
            <div class="font-sans text-[10px] uppercase tracking-[0.16em] text-stone-400 mb-1.5">Next</div>
            <div class="font-serif text-[15px] font-semibold text-ink group-hover:text-ember leading-snug">
              {next.label} &nbsp;&rarr;
            </div>
          </a>
        )}
      </div>
    </div>
  </div>
</main>
