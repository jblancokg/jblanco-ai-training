---
interface Props {
	number: number;
}

const { number } = Astro.props;
---

<div class="flex gap-3 items-start">
	<div
		class="w-7 h-7 rounded-full bg-orange-100 text-orange-700 flex items-center justify-center text-sm font-semibold shrink-0 mt-0.5"
	>
		{number}
	</div>
	<p class="text-sm text-stone-600 leading-relaxed">
		<slot />
	</p>
</div>
