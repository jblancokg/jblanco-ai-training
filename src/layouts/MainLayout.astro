---
import "../index.css";
import Sidebar from "../components/Sidebar.astro";

interface Props {
	title?: string;
}

const { title = "AI Training Guide" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Archivo:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script is:inline src="/pagefind/pagefind-ui.js"></script>
  </head>
  <body>
    <div class="flex bg-paper">
      <!-- Mobile overlay -->
      <div id="sidebar-overlay" class="fixed inset-0 bg-black/40 z-30 hidden lg:hidden" onclick="document.getElementById('sidebar-overlay')?.classList.add('hidden');document.getElementById('sidebar-panel')?.classList.add('-translate-x-full');"></div>
      <div id="sidebar-panel" class="fixed inset-y-0 left-0 z-40 w-72 -translate-x-full transition-transform duration-200 lg:static lg:translate-x-0">
        <Sidebar currentPath={currentPath} />
      </div>
      <slot />
    </div>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        new PagefindUI({
          element: "#search",
          showSubResults: true,
          showImages: false,
          resetStyles: false,
        });
      });
    </script>
    <style is:global>
      @keyframes doc-fade {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-doc-fade { animation: doc-fade 0.3s ease both; }

      /* Pagefind UI overrides for sidebar */
      .sidebar-search {
        position: relative;
      }
      .sidebar-search .pagefind-ui__search-input {
        font-size: 13px !important;
        padding: 6px 10px 6px 30px !important;
        border-radius: 0 !important;
        border: 1px solid #ddd5c7 !important;
        background: #fdfcf9 !important;
        height: auto !important;
        color: #2b2622 !important;
        font-family: 'Archivo', system-ui, sans-serif !important;
        font-weight: 400 !important;
      }
      .sidebar-search .pagefind-ui__search-input::placeholder {
        color: #a09585 !important;
        opacity: 1 !important;
      }
      .sidebar-search .pagefind-ui__search-input:focus {
        border-color: #2b2622 !important;
        outline: none !important;
        box-shadow: none !important;
      }
      .sidebar-search .pagefind-ui__search-clear {
        top: 1px !important;
        right: 2px !important;
        padding: 6px !important;
        background: transparent !important;
      }
      .sidebar-search .pagefind-ui__form::before {
        top: 8px !important;
        left: 10px !important;
        width: 14px !important;
        height: 14px !important;
        opacity: 0.4 !important;
      }
      .sidebar-search .pagefind-ui__drawer {
        position: absolute !important;
        top: 100% !important;
        left: -12px !important;
        width: 24rem !important;
        z-index: 50 !important;
        background: #fdfcf9 !important;
        border: 1px solid #ddd5c7 !important;
        border-top: none !important;
        border-radius: 0 !important;
        box-shadow: 0 8px 24px rgba(43, 38, 34, 0.14) !important;
        max-height: 60vh !important;
        overflow-y: auto !important;
        padding: 4px 12px 8px !important;
      }
      .sidebar-search .pagefind-ui__result-link {
        font-size: 13px !important;
        color: #2b2622 !important;
        font-family: 'Source Serif 4', Georgia, serif !important;
      }
      .sidebar-search .pagefind-ui__result-excerpt {
        font-size: 11px !important;
        color: #8a7f70 !important;
      }
      .sidebar-search .pagefind-ui__result {
        padding: 8px 4px !important;
        border-bottom: 1px solid #ece5d8 !important;
      }
      .sidebar-search .pagefind-ui__result-thumb,
      .sidebar-search .pagefind-ui__result-image {
        display: none !important;
      }
      .sidebar-search .pagefind-ui__results-area {
        margin-top: 0 !important;
      }
      .sidebar-search .pagefind-ui__message {
        font-size: 11px !important;
        color: #8a7f70 !important;
        padding: 4px !important;
      }
      .sidebar-search .pagefind-ui__button {
        font-size: 12px !important;
        background: #2b2622 !important;
        color: #f8f5ef !important;
        border: none !important;
        border-radius: 0 !important;
        height: auto !important;
        padding: 4px 10px !important;
        font-family: 'Archivo', system-ui, sans-serif !important;
      }
    </style>
  </body>
</html>
